# ManuElo — modelo de variaveis de ambiente.
# Copie para .env (que fica fora do Git) e preencha. Nunca commite o .env.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Em producao (Railway/Render/CI) cadastre as mesmas chaves como secrets.

# --- Banco (Spring Boot) ---
# Aponta para o Supabase (producao) ou para o banco local (dev).
DB_URL='jdbc:postgresql://HOST:5432/postgres?sslmode=require'
DB_USER=postgres.SEUPROJETO
DB_PASSWORD=SENHA

# Porta HTTP da aplicacao (PORT tem precedencia; APP_PORT e o fallback legado).
PORT=8080
APP_PORT=8080

# --- Administrador inicial ---
# Obrigatorios no perfil prod. A senha precisa ter no minimo 8 caracteres.
MANUELO_ADMIN_EMAIL=admin@manuelo.local
MANUELO_ADMIN_SENHA=troque-por-uma-senha-com-8-ou-mais-caracteres

# --- Aplicacao ---
# URL publica usada nos links de redefinicao de senha.
MANUELO_APP_URL=http://localhost:8080
# Diretorio do armazenamento local de documentos (dev/fallback).
MANUELO_STORAGE_DIR=/tmp/manuelo-documentos

# --- Banco local (docker compose) ---
POSTGRES_PASSWORD=troque-por-uma-senha-local
POSTGRES_PORT=55432

# --- Banco Supabase (Session pooler, porta 5432) ---
# Dashboard > Project Settings > Database > Connection string > URI > Session pooler
SUPABASE_DB_URL='postgresql://postgres.SEUPROJETO:SENHA@HOST:5432/postgres?sslmode=require'

# --- Supabase Storage (bucket privado de PDFs) ---
SUPABASE_URL='https://SEUPROJETO.supabase.co'
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
SUPABASE_BUCKET=documentos

# --- SMTP para redefinição de senha (opcional em dev) ---
# Sem SPRING_MAIL_HOST, o perfil dev apenas registra o link no log (DEC-I05).
# Em produção configure um SMTP real; o token nunca é logado fora de dev.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
