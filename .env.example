# ManuElo — modelo de variaveis de ambiente.
# Copie para .env (que fica fora do Git) e preencha. Nunca commite o .env.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Em producao (Railway/Render/CI) cadastre as mesmas chaves como secrets.

# --- Banco local (docker compose) ---
POSTGRES_PASSWORD=troque-por-uma-senha-local
POSTGRES_PORT=55432

# --- Banco Supabase (Session pooler, porta 5432) ---
# Dashboard > Project Settings > Database > Connection string > URI > Session pooler
SUPABASE_DB_URL='postgresql://postgres.SEUPROJETO:SENHA@HOST:5432/postgres?sslmode=require'

# --- Aplicacao Spring Boot ---
# Pode apontar para o Supabase (producao) ou para o banco local (dev).
DB_URL='jdbc:postgresql://HOST:5432/postgres?sslmode=require'
DB_USER=postgres.SEUPROJETO
DB_PASSWORD=SENHA
APP_PORT=8080
APP_TIMEZONE=America/Maceio

# --- Supabase Storage (bucket privado de PDFs) ---
SUPABASE_URL='https://SEUPROJETO.supabase.co'
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
SUPABASE_BUCKET=documentos
