Ref: relatorio_movimentacoes.movimentacao_id > movimentacoes.id [delete: restrict]

Ref: relatorio_contratos.relatorio_id > relatorios.id [delete: restrict]
Ref: relatorio_contratos.contrato_id > contratos.id [delete: restrict]

Ref: configuracoes.atualizado_por > usuarios.id [delete: restrict]

