Ref: contratos.atualizado_por > usuarios.id [delete: restrict]

Ref: caucao_movimentacoes.contrato_id > contratos.id [delete: restrict]
Ref: caucao_movimentacoes.movimentacao_id > movimentacoes.id [delete: restrict]
Ref: caucao_movimentacoes.documento_id > documentos.id [delete: restrict]
Ref: caucao_movimentacoes.criado_por > usuarios.id [delete: restrict]

Ref: movimentacoes.imovel_id > imoveis.id [delete: restrict]
Ref: movimentacoes.responsavel_id > usuarios.id [delete: restrict]
Ref: movimentacoes.contrato_id > contratos.id [delete: restrict]
Ref: movimentacoes.movimentacao_original_id > movimentacoes.id [delete: restrict]
Ref: movimentacoes.corrige_movimentacao_id > movimentacoes.id [delete: restrict]

Ref: documentos.movimentacao_id > movimentacoes.id [delete: restrict]
Ref: documentos.imovel_id > imoveis.id [delete: restrict]
Ref: documentos.inquilino_id > inquilinos.id [delete: restrict]
Ref: documentos.contrato_id > contratos.id [delete: restrict]
Ref: documentos.enviado_por > usuarios.id [delete: restrict]
Ref: documentos.atualizado_por > usuarios.id [delete: restrict]

Ref: reformas.imovel_id > imoveis.id [delete: restrict]
Ref: reformas.movimentacao_id > movimentacoes.id [delete: restrict]
Ref: reformas.criado_por > usuarios.id [delete: restrict]
Ref: reformas.atualizado_por > usuarios.id [delete: restrict]

